generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanType {
  FREE
  PRO
  BUSINESS
}

enum FormStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum QuestionType {
  STARS
  EMOJI
  CHOICE
  TEXT
}

enum FollowUpTrigger {
  LOW
  HIGH
}

enum RateLimitMode {
  NONE
  PER_SESSION
  PER_24H
  PER_WEEK
  CUSTOM
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String?
  businessName      String?
  businessType      String?
  plan              PlanType @default(FREE)
  stripeCustomerId  String?
  aiGenerationsUsed Int      @default(0)
  isDemo            Boolean   @default(false)
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  forms             Form[]
  aiConversations   AiConversation[]
  themes            Theme[]

  @@index([isDemo, expiresAt])
}

model Theme {
  id        String   @id @default(uuid())
  userId    String
  name      String
  config    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  forms     Form[]

  @@index([userId])
}

model Form {
  id             String        @id @default(uuid())
  userId         String
  themeId        String?
  title          String
  titleFr        String        @default("")
  titleEn        String?
  description    String?
  descriptionFr  String?
  descriptionEn  String?
  status         FormStatus    @default(DRAFT)
  slug           String        @unique
  rateLimitMode  RateLimitMode @default(PER_24H)
  rateLimitHours Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          Theme?        @relation(fields: [themeId], references: [id], onDelete: SetNull)
  questions      Question[]
  qrCodes        QRCode[]
  responses      Response[]
  aiConversation AiConversation?

  @@index([themeId])
}

model Question {
  id            String          @id @default(uuid())
  formId        String
  type          QuestionType
  label         String
  labelFr       String          @default("")
  labelEn       String?
  options       Json?
  order         Int
  required      Boolean         @default(true)
  hasBranching  Boolean         @default(false)
  createdAt     DateTime        @default(now())
  form          Form            @relation(fields: [formId], references: [id], onDelete: Cascade)
  followUpRules FollowUpRule[]
}

model FollowUpRule {
  id              String          @id @default(uuid())
  questionId      String
  triggerType     FollowUpTrigger
  triggerMin      Int
  triggerMax      Int
  followUpLabel   String
  followUpLabelFr String          @default("")
  followUpLabelEn String?
  followUpOptions Json
  followUpOptionsFr Json?
  followUpOptionsEn Json?
  allowFreeText   Boolean         @default(true)
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QRCode {
  id         String     @id @default(uuid())
  formId     String
  label      String
  uniqueCode String     @unique
  scans      Int        @default(0)
  createdAt  DateTime   @default(now())
  form       Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  responses  Response[]
}

model Visitor {
  id              String     @id @default(uuid())
  cookieId        String?    @unique
  fingerprintHash String?
  firstSeenAt     DateTime   @default(now())
  lastSeenAt      DateTime   @default(now())
  responseCount   Int        @default(0)
  responses       Response[]
}

model Response {
  id        String   @id @default(uuid())
  formId    String
  qrCodeId  String?
  visitorId String?
  answers   Json
  metadata  Json?
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  qrCode    QRCode?  @relation(fields: [qrCodeId], references: [id])
  visitor   Visitor? @relation(fields: [visitorId], references: [id])
}

model AiConversation {
  id              String      @id @default(uuid())
  formId          String      @unique
  userId          String
  phase           String      @default("wizard")
  businessContext Json
  proposedAngles  Json?
  selectedAngles  Json?
  generatedForm   Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  form            Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AiMessage[]
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String
  content        String
  suggestions    Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
