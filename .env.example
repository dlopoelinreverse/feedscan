# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key

# Database (Supabase PostgreSQL)
# Use connection pooling URL for Prisma ORM
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use direct connection URL for migrations
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Domains
NEXT_PUBLIC_ROOT_DOMAIN=feedscan.leopoldev
NEXT_PUBLIC_AUTH_DOMAIN=auth.feedscan.leopoldev
NEXT_PUBLIC_APP_DOMAIN=app.feedscan.leopoldev

# App
NEXT_PUBLIC_APP_URL=https://feedscan.leopoldev
