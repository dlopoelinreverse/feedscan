# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key

# Database (Supabase PostgreSQL)
# Use connection pooling URL for Prisma ORM
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Use direct connection URL for migrations
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# Domains
NEXT_PUBLIC_ROOT_DOMAIN=feedscan.leopoldev
NEXT_PUBLIC_AUTH_DOMAIN=auth.feed-scan.leopoldev
NEXT_PUBLIC_APP_DOMAIN=app.feed-scan.leopoldev

# App
NEXT_PUBLIC_APP_URL=https://feedscan.leopoldev
NEXT_PUBLIC_PORT=3001

# Demo mode
# Supabase service-role key — used server-side only to provision/destroy demo accounts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Shared secret for the /api/cron/cleanup-demo endpoint (generate via `openssl rand -hex 32`).
CRON_SECRET=replace-with-openssl-rand-hex-32

# AI cost protection (web/src/lib/ai/guard.ts)
# When DEMO_MODE=true, all /api/ai/** routes return static fixtures instead of calling Anthropic.
DEMO_MODE=false
# Comma-separated list of IPs that bypass DEMO_MODE and rate-limiting entirely.
# Resolved against x-forwarded-for (leftmost entry) then x-real-ip.
AI_IP_WHITELIST=
# Maximum number of real Anthropic calls per rolling 24h window across all clients.
# Once reached, /api/ai/** returns 503 until the window resets.
AI_GLOBAL_DAILY_CAP=200
